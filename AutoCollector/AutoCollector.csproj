<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <!--
    TargetFramework / LangVersion / Platforms / Nullable / AllowUnsafeBlocks /
    DalamudLibPath / DalamudPackager の参照はすべて Dalamud.NET.Sdk の既定値を使う。
    上書きすると SDK 更新に追従できなくなるため、ここでは書かない。
  -->
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <RootNamespace>AutoCollector</RootNamespace>
    <AssemblyName>AutoCollector</AssemblyName>
    <Description>通貨が閾値に到達したら自動処理を停止し、交換所へ移動して交換し、復帰する</Description>
    <Authors>rioriopu</Authors>
  </PropertyGroup>

  <ItemGroup>
    <!-- manifest 本体。DalamudPackager が InternalName / AssemblyVersion / DalamudApiLevel を補完する -->
    <Content Include="AutoCollector.json" />
    <!--
      補助データは出力へのコピー挙動に依存させたくないため埋め込みリソースにする。
      初回起動時にプラグイン設定ディレクトリへ展開し、以後はユーザーが編集できる。
    -->
    <EmbeddedResource Include="Data\atkvalue_layout.json" />
    <EmbeddedResource Include="Data\special_currency_map.json" />
    <!--
      プラグイン一覧に出すアイコン。DalamudPackager が zip へ含める。
      dev プラグインとして読み込む場合も、DLL の隣の images\icon.png が使われる。
    -->
    <None Include="images\icon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    ビルド時刻をアセンブリ自身へ埋め込む。
    ファイルの更新時刻を読むと、古い DLL が読み込まれたまま
    ファイルだけ上書きされた場合に、新しい時刻を表示しながら
    古いコードが動くことになる。切り分けの役に立たない。
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm:ss'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.17" />
  </ItemGroup>

  <!-- Debug ビルドは dev プラグイン置き場へ直接出力する -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <OutputPath>C:\DevPlugins\AutoCollector\</OutputPath>
  </PropertyGroup>

</Project>
